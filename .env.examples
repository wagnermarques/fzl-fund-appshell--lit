# ==============================================================================
# Environment Configuration Template — fzl-fund-appshell--lit
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` or `.env.local` for local development.
# 2. Adjust values according to your environment.
# 3. For CI/CD deployments, use the corresponding script in `scripts/`:
#    - GitHub Actions:   ./scripts/set-github-variables.sh
#    - Cloudflare Pages: ./scripts/set-cloudflare-variables.sh
#    - GitLab CI/CD:     ./scripts/set-gitlab-variables.sh
# ==============================================================================

# Backend REST API Base URL
VITE_REST_API_BASE_URL=http://localhost:8080/api

# Google Analytics 4 (GA4) Measurement ID (format: G-XXXXXXXXXX)
VITE_GA4_MEASUREMENT_ID=

# App Title Override (Optional)
VITE_APP_TITLE=
