# ==============================================================================
# Environment Configuration Template — fzl-fund-appshell--lit
# ==============================================================================
# Instructions:
# 0. Defaults live in appshell.config.js. These variables override them per
#    environment without editing that file. Naming rule: VITE_APPSHELL_ + the
#    option path in UPPER_SNAKE_CASE (push.vapidPublicKey ->
#    VITE_APPSHELL_PUSH_VAPID_PUBLIC_KEY). Older names (VITE_GA4_MEASUREMENT_ID,
#    VITE_PUSH_VAPID_PUBLIC_KEY, VITE_APP_TITLE, VITE_REST_API_BASE_URL) still work, below the new ones.
#    Never put secrets here or in appshell.config.js: VITE_* values end up in
#    the JavaScript every browser downloads.
# 1. Copy this file to `.env` or `.env.local` for local development.
# 2. Adjust values according to your environment.
# 3. For CI/CD deployments, use the corresponding script in `scripts/`:
#    - GitHub Actions:   ./scripts/set-github-variables.sh
#    - Cloudflare Pages: ./scripts/set-cloudflare-variables.sh
#    - GitLab CI/CD:     ./scripts/set-gitlab-variables.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend "api" URL  -> backends.api.url
# ------------------------------------------------------------------------------
# Address of the "api" backend declared in appshell.config.js. Every declared
# backend has its own variable: VITE_APPSHELL_BACKENDS_<NAME>_URL.
# Displayed in the UI under: Config > Backend (#/config/backend).
# The older name VITE_REST_API_BASE_URL still works.
#
# Examples:
#   Local dev:   http://localhost:8080/api
#   Production:  https://api.meudominio.com/v1
VITE_APPSHELL_BACKENDS_API_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# 2. Google Analytics 4 (GA4) Measurement ID  -> analytics.id
# ------------------------------------------------------------------------------
# Format: G-XXXXXXXXXX (found in Google Analytics > Admin > Data Streams).
# Leave blank (or omit) during local development to disable tracking.
#
# Notes:
# - Each consumer app uses its own GA4 property ID.
# - The appshell respects LGPD/Consent Mode v2: no cookies are stored before consent.
VITE_APPSHELL_ANALYTICS_ID=

# ------------------------------------------------------------------------------
# 3. Web Push — VAPID public key (Optional)  -> push.vapidPublicKey
# ------------------------------------------------------------------------------
# Public half of the VAPID key pair used by the app's backend to send pushes.
# Generate a pair with:  npx web-push generate-vapid-keys
# Only the PUBLIC key goes here; the private key stays on the backend.
# Leave blank to disable push (Config > Notificações disappears).
VITE_APPSHELL_PUSH_VAPID_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 4. App Title Override (Optional)  -> title
# ------------------------------------------------------------------------------
# Overrides the title from appshell.config.js (header, tab title).
VITE_APPSHELL_TITLE=
