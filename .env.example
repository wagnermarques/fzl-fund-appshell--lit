# Copie este arquivo para .env.local e ajuste os valores para o seu ambiente.
#
# VITE_REST_API_BASE_URL é a fonte da verdade para o path base usado pelo
# appshell para acessar os serviços REST do backend (ver menu
# Config > Backend > Serviços REST). A tela de configuração só exibe este
# valor por enquanto — ainda não é possível alterá-lo pela interface.
VITE_REST_API_BASE_URL=http://localhost:8080/api

# VITE_GA4_MEASUREMENT_ID é o Measurement ID do Google Analytics 4 deste
# app (Admin > Fluxos de dados, formato G-XXXXXXXXXX). Cada app que usa o
# appshell tem a sua própria propriedade do GA4 — o id é passado em
# createAppShell({ analytics: { id } }), nunca fica embutido no shell.
# Deixe em branco (ou não defina) para rodar sem medição, que é o normal
# em desenvolvimento.
VITE_GA4_MEASUREMENT_ID=
